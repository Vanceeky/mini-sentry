{
  "name": "@vanceeq/canary",
  "version": "0.1.1",
  "description": "Framework-agnostic client-side error monitoring SDK",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Vanceeky/mini-sentry.git",
    "directory": "sdk"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:esm && npm run build:cdn",
    "build:esm": "esbuild src/index.ts --bundle --format=esm --sourcemap --platform=neutral --outfile=dist/index.js",
    "build:cdn": "esbuild src/index.ts --bundle --minify --sourcemap --format=iife --global-name=Canary --outfile=dist/canary.min.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
