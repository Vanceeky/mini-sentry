{
  "name": "@mini-sentry/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Framework-agnostic client-side error monitoring SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:cdn",
    "build:cdn": "esbuild src/index.ts --bundle --minify --sourcemap --format=iife --global-name=MiniSentry --outfile=dist/mini-sentry.min.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
