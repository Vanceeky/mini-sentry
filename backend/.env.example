# Local Postgres started via `docker compose -f backend/docker-compose.yml up -d`.
# Port 5433 (not 5432) deliberately, to avoid colliding with a Postgres already
# running locally on the default port.
#
# DATABASE_URL is what the running app connects with (pooled, in production —
# e.g. Neon's "-pooler" endpoint). DIRECT_URL is what `prisma migrate`
# connects with (unpooled — migrations can't run reliably through a
# connection pooler). Locally there's no pooler, so both point at the same
# docker-compose Postgres.
DATABASE_URL="postgresql://mini_sentry:mini_sentry@localhost:5433/mini_sentry?schema=public"
DIRECT_URL="postgresql://mini_sentry:mini_sentry@localhost:5433/mini_sentry?schema=public"

# Comma-separated list of exact browser origins allowed to POST to /api/v1/events
# via CORS. Non-browser callers (curl, server-to-server, the mobile app) are not
# affected by this — CORS is a browser-only enforcement mechanism. Never set to "*".
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Comma-separated list of email addresses that get promoted to SUPERADMIN on
# their next login/register. Promotion-only: removing an email from this list
# does NOT demote an already-promoted account — that requires a deliberate
# future admin action. Leave empty/unset to grant no superadmin access.
SUPERADMIN_EMAILS=

# Optional: real SMTP delivery for invitation emails (e.g. Gmail + an App
# Password — not your normal account password). All five must be set
# together or invitation email falls back to logging (console) instead of
# sending — the raw token in the invitation-creation API response is always
# the reliable way to deliver an invite either way.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional: base URL of a deployed web app that serves an
# /invitations/accept?token=... page. When unset, invitation emails include
# the raw token as plain text instead of a clickable link.
WEB_APP_BASE_URL=
