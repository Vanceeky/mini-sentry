# Local Postgres started via `docker compose -f backend/docker-compose.yml up -d`.
# Port 5433 (not 5432) deliberately, to avoid colliding with a Postgres already
# running locally on the default port.
DATABASE_URL="postgresql://mini_sentry:mini_sentry@localhost:5433/mini_sentry?schema=public"

# Comma-separated list of exact browser origins allowed to POST to /api/v1/events
# via CORS. Non-browser callers (curl, server-to-server, the mobile app) are not
# affected by this — CORS is a browser-only enforcement mechanism. Never set to "*".
CORS_ALLOWED_ORIGINS="http://localhost:5173"

# Comma-separated list of email addresses that get promoted to SUPERADMIN on
# their next login/register. Promotion-only: removing an email from this list
# does NOT demote an already-promoted account — that requires a deliberate
# future admin action. Leave empty/unset to grant no superadmin access.
SUPERADMIN_EMAILS=
