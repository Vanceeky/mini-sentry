generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 7 fields kept additive-only, per that phase's note — the seed data /
// dev API key / existing tests all depend on this exact shape.
//
// ownerId is nullable (not required) deliberately: the Phase 7 seed project
// predates the concept of ownership (User didn't exist until Phase 9), and
// backfilling a NOT NULL constraint onto existing rows is a real-data-risk
// migration this project has no reason to take on for a dev fixture. Every
// project created through POST /api/v1/projects (Phase 10) always sets it —
// see lib/project.ts. apiKeyLastFour is nullable for the same reason (it
// didn't exist before Phase 10); it's set on every create/rotate from here on.
model Project {
  id             String   @id @default(cuid())
  name           String
  apiKeyHash     String   @unique
  apiKeyLastFour String?
  ownerId        String?
  owner          User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  errorGroups ErrorGroup[]
  errorEvents ErrorEvent[]

  @@index([ownerId])
  @@map("projects")
}

// One row per distinct fingerprint within a project — see
// lib/fingerprint.ts for how the fingerprint is derived. `message`/`type`/
// `endpoint`/`statusCode`/`environment` all hold the *first* occurrence's
// values as a representative label (not updated on later occurrences) —
// matches Phase 11's error list/detail API, which needs a stable summary
// row per group without joining to an event on every list query.
// `endpoint`/`statusCode` are null for non-"http" groups (see lib/persistEvent.ts).
// `environment` is nullable only for backward compatibility with any group
// rows that predate this Phase 11 column (same rationale as Project's
// nullable Phase 10 fields) — every group persistEvent.ts creates from here
// on always sets it (currently always "browser", per the SDK's fixed
// literal — see DECISIONS.md, Phase 2).
model ErrorGroup {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fingerprint     String
  type            String
  message         String
  endpoint        String?
  statusCode      Int?
  environment     String?
  firstSeenAt     DateTime @default(now())
  lastSeenAt      DateTime @default(now())
  occurrenceCount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  events ErrorEvent[]

  @@unique([projectId, fingerprint])
  @@index([projectId])
  @@index([fingerprint])
  @@map("error_groups")
}

// One row per ingested event, always attached to a group. Mirrors
// CapturedEvent's fields; `os` and `metadata` are reserved columns the
// current SDK contract has no data for yet (see DECISIONS.md) — always null
// today, not derived or faked.
model ErrorEvent {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  groupId     String
  group       ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type        String
  message     String
  stack       String?
  filename    String?
  line        Int?
  column      Int?
  url         String
  method      String?
  statusCode  Int?
  timestamp   DateTime
  browser     String
  os          String?
  environment String
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([projectId])
  @@index([groupId])
  @@index([createdAt])
  @@index([timestamp])
  @@map("error_events")
}

// A developer account (landing/onboarding, dashboard, mobile login) —
// distinct from Project, which represents an app being monitored, not a
// person. passwordHash is salted scrypt (see lib/password.ts), never the
// project-API-key-style unsalted hash used elsewhere in this schema.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]
  projects Project[]
  devices  Device[]

  @@map("users")
}

// A registered push-notification target (Phase 12) — associated with the
// authenticated developer, not a project, since one developer's devices
// should hear about all of their projects' errors. `pushToken` is unique:
// re-registering the same token (e.g. after an app reinstall re-issues the
// same token, or a device changes hands) upserts onto the existing row
// rather than creating a duplicate — see lib/device.ts.
model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  pushToken String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("devices")
}

// One row per active login. tokenHash is unsalted SHA-256 of a random
// 32-byte token (same rationale as Project.apiKeyHash — high-entropy,
// nothing to salt against). The raw token is returned to the client exactly
// once, at login, and never stored.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}
