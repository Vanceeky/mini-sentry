generator client {
  provider = "prisma-client-js"
}

// url is the pooled connection string (e.g. Neon's PgBouncer "-pooler"
// endpoint) — what the running app uses, since a serverless deployment can
// open many concurrent short-lived connections. directUrl is the direct
// (unpooled) connection string, used only by `prisma migrate deploy`/`dev`,
// which can't run reliably through a pooler. Locally, both can point at the
// same docker-compose Postgres — see .env.example.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  SUPERADMIN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

enum ErrorGroupStatus {
  PENDING
  IN_PROGRESS
  DONE
}

// Phase 7 fields kept additive-only, per that phase's note — the seed data /
// dev API key / existing tests all depend on this exact shape.
//
// ownerId is nullable (not required) deliberately: the Phase 7 seed project
// predates the concept of ownership (User didn't exist until Phase 9), and
// backfilling a NOT NULL constraint onto existing rows is a real-data-risk
// migration this project has no reason to take on for a dev fixture. Every
// project created through POST /api/v1/projects (Phase 10) always sets it —
// see lib/project.ts. apiKeyLastFour is nullable for the same reason (it
// didn't exist before Phase 10); it's set on every create/rotate from here on.
//
// Phase 15 replaced the Phase 14 Team/TeamMember indirection: a project has
// members directly. ownerId is still the single accountable creator (and
// the only "lead" — no promotable role exists on members, see ProjectMember)
// who can rename/delete the project, rotate its key, invite/remove members.
// A member (via ProjectMember) gets read access to the project's error data
// and can assign/reassign themselves and set error status; only the owner
// can assign to someone other than themselves. See lib/access.ts's
// resolveProjectAccess() and DECISIONS.md.
model Project {
  id             String   @id @default(cuid())
  name           String
  apiKeyHash     String   @unique
  apiKeyLastFour String?
  ownerId        String?
  owner          User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  errorGroups ErrorGroup[]
  errorEvents ErrorEvent[]
  members     ProjectMember[]
  invitations Invitation[]

  @@index([ownerId])
  @@map("projects")
}

// Direct project membership (Phase 15, replacing Team/TeamMember). Flat —
// no role field: the only privileged actor is the project's owner
// (Project.ownerId), checked directly wherever owner-only logic lives (see
// lib/projectMembers.ts, lib/assignment.ts). onDelete: Cascade both
// directions — a membership row has no independent meaning once either side
// is gone. The owner deliberately never gets a ProjectMember row of their
// own; ownership lives solely in Project.ownerId (see
// lib/projectMembers.ts's listProjectMembers(), which synthesizes an owner
// row on top of these). @@unique([projectId, userId]) gives lib/access.ts a
// single compound-unique lookup for "is this user a member of this project."
model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

// A pending (or resolved) invite to join a project directly, identified by
// email since the invited person may not have an account yet — Phase 15
// re-scoped this from teams to projects, and dropped the role field
// entirely (every accepted invitation just grants plain membership; there's
// nothing to assign a role to). tokenHash follows the same
// unsalted-sha256-of-a-high-entropy-random-value pattern as
// Project.apiKeyHash/Session.tokenHash — the raw token is returned to the
// inviter exactly once (see lib/invitation.ts), also used to actually send
// an invite email (lib/email.ts) and to preview/redeem the invite (a public
// GET /invitations/preview, and optionally during registration itself) —
// with the token itself as the manual fallback if email delivery fails.
//
// invitedById is nullable + SetNull: deleting the inviter shouldn't
// invalidate an otherwise-still-valid invitation.
//
// No DB-level unique constraint on [projectId, invitedEmail]: Postgres can
// only express "unique while status=PENDING" via a partial index, which
// Prisma's schema DSL doesn't support declaratively. "No duplicate pending
// invite" is instead enforced in lib/invitation.ts by checking for an
// existing PENDING row before creating — see DECISIONS.md.
model Invitation {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedEmail String
  tokenHash    String            @unique
  status       InvitationStatus  @default(PENDING)
  invitedById  String?
  invitedBy    User?             @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt    DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([projectId])
  @@index([invitedEmail])
  @@map("invitations")
}

// One row per distinct fingerprint within a project — see
// lib/fingerprint.ts for how the fingerprint is derived. `message`/`type`/
// `endpoint`/`statusCode`/`environment` all hold the *first* occurrence's
// values as a representative label (not updated on later occurrences) —
// matches Phase 11's error list/detail API, which needs a stable summary
// row per group without joining to an event on every list query.
// `endpoint`/`statusCode` are null for non-"http" groups (see lib/persistEvent.ts).
// `environment` is nullable only for backward compatibility with any group
// rows that predate this Phase 11 column (same rationale as Project's
// nullable Phase 10 fields) — every group persistEvent.ts creates from here
// on always sets it (currently always "browser", per the SDK's fixed
// literal — see DECISIONS.md, Phase 2).
//
// assigneeId (Phase 14) is nullable and onDelete: SetNull — assigning is a
// mutable, informational pointer to a User, never a required field, and
// deleting the assigned user (or removing them from the project, handled at
// the app layer, not the DB) must unassign rather than delete the group. No
// DB constraint ties assigneeId to the project's membership — that's
// enforced at assignment time in lib/assignment.ts, since Prisma FKs can't
// express a cross-table conditional constraint.
//
// status (Phase 15) is a second, independent way to track error-handling
// progress, deliberately more open than assignment: any project member or
// the owner may set it, regardless of who (if anyone) it's assigned to —
// see lib/assignment.ts's updateErrorGroupStatus() and DECISIONS.md. Purely
// human-managed — never touched by lib/persistEvent.ts on new occurrences.
model ErrorGroup {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fingerprint     String
  type            String
  message         String
  endpoint        String?
  statusCode      Int?
  environment     String?
  firstSeenAt     DateTime         @default(now())
  lastSeenAt      DateTime         @default(now())
  occurrenceCount Int              @default(0)
  assigneeId      String?
  assignee        User?            @relation("ErrorGroupAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  status          ErrorGroupStatus @default(PENDING)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  events ErrorEvent[]

  @@unique([projectId, fingerprint])
  @@index([projectId])
  @@index([fingerprint])
  @@index([assigneeId])
  @@index([status])
  @@map("error_groups")
}

// One row per ingested event, always attached to a group. Mirrors
// CapturedEvent's fields; `os` and `metadata` are reserved columns the
// current SDK contract has no data for yet (see DECISIONS.md) — always null
// today, not derived or faked.
model ErrorEvent {
  id          String     @id @default(cuid())
  projectId   String
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  groupId     String
  group       ErrorGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type        String
  message     String
  stack       String?
  filename    String?
  line        Int?
  column      Int?
  url         String
  method      String?
  statusCode  Int?
  timestamp   DateTime
  browser     String
  os          String?
  environment String
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([projectId])
  @@index([groupId])
  @@index([createdAt])
  @@index([timestamp])
  @@map("error_events")
}

// A developer account (landing/onboarding, dashboard, mobile login) —
// distinct from Project, which represents an app being monitored, not a
// person. passwordHash is salted scrypt (see lib/password.ts), never the
// project-API-key-style unsalted hash used elsewhere in this schema.
//
// role (Phase 14) defaults to USER; SUPERADMIN is granted only via the
// SUPERADMIN_EMAILS env-var allowlist, re-checked on every login/register —
// see lib/adminGuard.ts and DECISIONS.md. Promotion-only: removing an email
// from the allowlist never auto-demotes an already-promoted account.
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions           Session[]
  projects           Project[]
  devices            Device[]
  projectMemberships ProjectMember[]
  assignedGroups     ErrorGroup[]    @relation("ErrorGroupAssignee")
  sentInvitations    Invitation[]    @relation("InvitationInvitedBy")

  @@map("users")
}

// A registered push-notification target (Phase 12) — associated with the
// authenticated developer, not a project, since one developer's devices
// should hear about all of their projects' errors. `pushToken` is unique:
// re-registering the same token (e.g. after an app reinstall re-issues the
// same token, or a device changes hands) upserts onto the existing row
// rather than creating a duplicate — see lib/device.ts.
model Device {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform  String
  pushToken String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("devices")
}

// One row per active login. tokenHash is unsalted SHA-256 of a random
// 32-byte token (same rationale as Project.apiKeyHash — high-entropy,
// nothing to salt against). The raw token is returned to the client exactly
// once, at login, and never stored.
model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}
