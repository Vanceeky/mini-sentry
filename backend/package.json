{
  "name": "@mini-sentry/backend",
  "version": "0.0.0",
  "private": true,
  "description": "Mini Sentry backend/API — Next.js REST API backed by PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "firebase-admin": "14.3.0",
    "next": "^16.3.3",
    "nodemailer": "^9.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
